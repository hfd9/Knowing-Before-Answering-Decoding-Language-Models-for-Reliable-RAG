# Source from a shell before running an experiment.
export CUDA_VISIBLE_DEVICES=0
export KBA_MODEL_3B='/large_disk/wf/研究代码/RAG/OpenDecoder/checkpoint/Qwen2.5-3B-Instruct'
export KBA_MODEL_7B='/large_disk/wf/研究代码/RAG/OpenDecoder/checkpoint/Qwen2.5-7B-Instruct'
